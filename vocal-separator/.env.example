# Compose-level overrides (docker-compose var substitution). This file must
# be named vocal-separator/.env - docker-compose reads it automatically for
# ${VAR} references in docker-compose.yml. It is separate from
# backend/.env, which sets environment variables *inside* the containers.

# Host path to your browser's profile directory, bind-mounted read-only into
# backend/celery so yt-dlp can read YouTube cookies live from it (see
# backend/.env.example for YOUTUBE_COOKIES_BROWSER, the matching setting
# that tells yt-dlp which browser it is). Path differs per OS/user/browser -
# reliable only for Firefox-based browsers (see backend/config.py).
#
# Examples:
#   macOS Firefox:   /Users/<you>/Library/Application Support/Firefox/Profiles/xxxxxxxx.default-release
#   Linux Firefox:   /home/<you>/.mozilla/firefox/xxxxxxxx.default-release
#   Windows Firefox: C:\Users\<you>\AppData\Roaming\Mozilla\Firefox\Profiles\xxxxxxxx.default-release
#
# Find your exact profile folder name by visiting about:profiles in Firefox.
# Leave unset to skip this mount entirely (falls back to YOUTUBE_COOKIES_FILE
# or no cookies).
# YOUTUBE_BROWSER_PROFILE_HOST_PATH=/Users/<you>/Library/Application Support/Firefox/Profiles/xxxxxxxx.default-release
