.venv/
__pycache__/
*.py[cod]
.env

# Python environments and build artifacts
venv/
.python-version
*.egg-info/
dist/
build/

# Node and frontend artifacts
node_modules/
.env.local
.env.*.local
npm-debug.log*

# IDE and operating system files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Runtime data and logs
/uploads/
/outputs/
/backend/uploads/*
!/backend/uploads/.gitkeep
/backend/outputs/*
!/backend/outputs/.gitkeep
*.log

# YouTube session cookies (sensitive - never commit)
/backend/cookies/*
!/backend/cookies/.gitkeep
!/backend/cookies/README.md

# Local placeholder for a bind-mounted browser profile (sensitive - never
# commit; the real profile normally lives outside the repo on the host)
/backend/browser_profile/*
!/backend/browser_profile/.gitkeep
!/backend/browser_profile/README.md
