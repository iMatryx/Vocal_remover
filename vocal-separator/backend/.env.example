# Redis connection settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional explicit Celery URLs; leave blank to use the Redis URL built above
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Demucs model: htdemucs (fast, great quality) or htdemucs_ft (slower, best quality)
DEMUCS_MODEL=htdemucs

# Cores used for separation. Fewer = cooler, quieter machine but slower.
# Default is 60% of available cores.
DEMUCS_THREADS=6

# Overlap between processed chunks: higher = better quality, slower
DEMUCS_OVERLAP=0.25


# How long uploads and separated stems are kept before automatic deletion
RETENTION_HOURS=1

# How often the cleanup job runs, in minutes
CLEANUP_INTERVAL_MINUTES=15

# Application logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional maximum upload size in megabytes. Default is 500 MB.
# MAX_FILE_SIZE_MB=500

# Comma-separated frontend origins for local development
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated yt-dlp player clients to request (e.g. "android,ios").
# Mobile app clients get YouTube's lighter anti-bot check (unlike the web
# client), which is what gets past "Sign in to confirm you're not a bot" -
# no account, cookies, or login needed. Not guaranteed long-term, since
# YouTube tightens this over time. Default: android. Leave empty to use
# yt-dlp's own default clients instead.
# YOUTUBE_PLAYER_CLIENTS=android

# Base URL of the companion PO Token provider server (see docker-compose.yml's
# "bgutil-provider" service). Generates the Proof-of-Origin token YouTube's
# anti-bot checks increasingly require, without cookies or an account.
# Default already points at the bundled bgutil-provider container over the
# internal Docker network - only override if you're running that service
# elsewhere. Leave empty to disable (yt-dlp then proceeds without a token).
# YOUTUBE_POT_PROVIDER_BASE_URL=http://bgutil-provider:4416

# yt-dlp's own "auto" policy only fetches a PO Token when its internal
# heuristic decides one is strictly required at that exact call site -
# which metadata-only lookups don't always reach, even for clients whose
# policy says a token IS required (android included). "always" forces it
# on every request (only takes effect when a provider is configured
# above); "never" disables fetching entirely; "auto" restores yt-dlp's
# default heuristic.
# YOUTUBE_POT_FETCH_POLICY=always

# URL of your own self-hosted Cobalt instance (https://github.com/imputnet/cobalt),
# e.g. deployed on Render with a clean, non-datacenter IP. When set,
# download_audio() sends the download to Cobalt instead of running yt-dlp
# locally - useful when this server's IP gets blocked outright and the
# player-client/PO-Token workarounds above aren't enough on their own.
# fetch_video_metadata() (title/duration/uploader lookup) still uses
# yt-dlp regardless, since Cobalt's response doesn't include those.
# Leave empty (default) to always use yt-dlp for downloads too.
#
# Must be your OWN instance - cobalt's docs explicitly ask that public/
# shared instances (like api.cobalt.tools) not be used by other projects
# without permission.
# COBALT_API_URL=https://your-cobalt-instance.onrender.com

# Only needed if your Cobalt instance requires API-key authentication.
# COBALT_API_KEY=

# COBALT_REQUEST_TIMEOUT_SECONDS=30
# COBALT_DOWNLOAD_TIMEOUT_SECONDS=300


# ========== OPTIMIZATION SETTINGS ==========

# Audio output format: mp3 (default, 80% smaller) or wav (uncompressed, higher quality)
AUDIO_OUTPUT_FORMAT=mp3

# MP3 bitrate: 128k (default, optimized), 192k, 256k, 320k
# Higher bitrate = better quality but larger file size. 128k is transparent for voice.
MP3_BITRATE=128k

# Model idle timeout in seconds: unload from RAM if idle to save ~80 MB.
# Default 3600 (1h) keeps the model warm between songs so there is no
# reload delay at the start of each task. Set to 0 to never unload.
MODEL_IDLE_TIMEOUT_SECONDS=3600
