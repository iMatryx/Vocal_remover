# Redis connection settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional explicit Celery URLs; leave blank to use the Redis URL built above
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Demucs model: htdemucs (fast, great quality) or htdemucs_ft (slower, best quality)
DEMUCS_MODEL=htdemucs

# Cores used for separation. Fewer = cooler, quieter machine but slower.
# Default is 60% of available cores.
DEMUCS_THREADS=6

# Overlap between processed chunks: higher = better quality, slower
DEMUCS_OVERLAP=0.25


# How long uploads and separated stems are kept before automatic deletion
RETENTION_HOURS=1

# How often the cleanup job runs, in minutes
CLEANUP_INTERVAL_MINUTES=15

# Application logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional maximum upload size in megabytes. Default is 500 MB.
# MAX_FILE_SIZE_MB=500

# Comma-separated frontend origins for local development
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated yt-dlp player clients to request (e.g. "android,ios").
# Mobile app clients get YouTube's lighter anti-bot check (unlike the web
# client), which is what gets past "Sign in to confirm you're not a bot" -
# no account, cookies, or login needed. Not guaranteed long-term, since
# YouTube tightens this over time. Default: android. Leave empty to use
# yt-dlp's own default clients instead.
# YOUTUBE_PLAYER_CLIENTS=android


# ========== OPTIMIZATION SETTINGS ==========

# Audio output format: mp3 (default, 80% smaller) or wav (uncompressed, higher quality)
AUDIO_OUTPUT_FORMAT=mp3

# MP3 bitrate: 128k (default, optimized), 192k, 256k, 320k
# Higher bitrate = better quality but larger file size. 128k is transparent for voice.
MP3_BITRATE=128k

# Model idle timeout in seconds: unload from RAM if idle to save ~80 MB.
# Default 3600 (1h) keeps the model warm between songs so there is no
# reload delay at the start of each task. Set to 0 to never unload.
MODEL_IDLE_TIMEOUT_SECONDS=3600
